def set_facebook_window_icon(win):
    ico_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "fb_icon.ico")
    if os.path.exists(ico_path):
        try:
            win.iconbitmap(ico_path)
            return
        except:
            pass

    # Built-in blue Facebook 'f' icon (32x32)
    size = 32
    img = tk.PhotoImage(width=size, height=size)
    fb_blue = "#1877F2"
    white = "#FFFFFF"

    for y in range(size):
        for x in range(size):
            # Rounded corner mask
            dx = max(0, 4 - x, x - (size - 5))
            dy = max(0, 4 - y, y - (size - 5))
            if dx * dx + dy * dy <= 16:
                img.put(fb_blue, (x, y))

    # Draw stylized 'f'
    for y in range(7, 29):
        for x in range(16, 21):
            if y == 7 and x < 18:
                continue
            img.put(white, (x, y))
    for y in range(7, 13):
        for x in range(17, 25):
            if (x - 17) + (12 - y) < 3:
                continue
            img.put(white, (x, y))
    for y in range(14, 18):
        for x in range(12, 24):
            img.put(white, (x, y))

    win._fb_icon_ref = img
    win.iconphoto(True, img)

def get_all_profiles(folder):
    nums = []
    if not os.path.exists(folder): return []
    for name in os.listdir(folder):
        m = re.match(r"Profile\s*(\d+)", name, re.IGNORECASE)
        if m: nums.append(int(m.group(1)))
    nums.sort()
    return nums

